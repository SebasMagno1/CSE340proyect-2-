<%- include("partials/header", { title: title }) %>

<section>

    <h2><%= category.category_name %></h2>

    <p>
        <%= category.description %>
    </p>

</section>

<section>

    <h2>Projects in This Category</h2>

    <% if (projects.length > 0) { %>

        <div class="cards">

            <% projects.forEach(project => { %>

                <article class="card">

                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        <strong>Organization:</strong>

                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>

                    <p>
                        <strong>Date:</strong>
                        <%= project.project_date.toLocaleDateString() %>
                    </p>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <p>
            There are no projects in this category.
        </p>

    <% } %>

</section>

<p>
    <a class="button" href="/categories">
        Back to Categories
    </a>
</p>

<%- include("partials/footer") %>