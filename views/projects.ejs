<%- include("partials/header", { title: title }) %>

<section>

    <h2><%= title %></h2>

    <p>
        Explore available community service projects.
    </p>

    <% if (projects && projects.length > 0) { %>

        <div class="cards">

            <% projects.forEach(project => { %>

                <article class="card">

                    <h3>
                        <a href="/projects/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <% if (project.description) { %>
                        <p>
                            <%= project.description %>
                        </p>
                    <% } %>

                    <p>
                        <strong>Organization:</strong>

                        <a href="/organizations/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <% if (project.location) { %>
                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>
                    <% } %>

                    <% if (project.project_date) { %>
                        <p>
                            <strong>Date:</strong>
                            <%= new Date(project.project_date).toLocaleDateString() %>
                        </p>
                    <% } %>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <p>
            No service projects are currently available.
        </p>

    <% } %>

</section>

<%- include("partials/footer") %>