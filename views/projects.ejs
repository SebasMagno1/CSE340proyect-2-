<%- include("partials/header", { title: title }) %>

<section>

    <h2><%= title %></h2>

    <p>
        Explore available community service projects.
    </p>

    <div class="cards">

        <% projects.forEach(project => { %>

            <article class="card">

                <h3>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </h3>

                <p>
                    <%= project.description %>
                </p>

                <p>
                    <strong>Organization:</strong>

                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>

                <p>
                    <strong>Location:</strong>
                    <%= project.location %>
                </p>

                <p>
                    <strong>Date:</strong>
                    <%= project.project_date.toLocaleDateString() %>
                </p>

            </article>

        <% }) %>

    </div>

</section>

<%- include("partials/footer") %>