<%- include("partials/header", { title: title }) %>

<section>

    <h2><%= organization.organization_name %></h2>

    <% if (organization.description) { %>
        <p>
            <%= organization.description %>
        </p>
    <% } %>

    <% if (organization.website) { %>

        <p>
            <strong>Website:</strong>

            <a
                href="<%= organization.website %>"
                target="_blank"
                rel="noopener noreferrer"
            >
                Visit Organization Website
            </a>
        </p>
        
    <% } %>

</section>


<section>

    <h2>Service Projects</h2>

    <% if (projects.length > 0) { %>

        <div class="cards">

            <% projects.forEach(project => { %>

                <article class="card">

                    <h3>
                        <a href="/projects/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <% if (project.description) { %>
                        <p>
                            <%= project.description %>
                        </p>
                    <% } %>

                    <% if (project.location) { %>
                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>
                    <% } %>

                    <% if (project.project_date) { %>
                        <p>
                            <strong>Date:</strong>
                            <%= new Date(project.project_date).toLocaleDateString() %>
                        </p>
                    <% } %>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <p>
            This organization currently has no projects.
        </p>

    <% } %>

</section>


<p>
    <a class="button" href="/organizations">
        Back to Organizations
    </a>
</p>

<%- include("partials/footer") %>